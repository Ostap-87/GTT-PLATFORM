{
  "expo": {
    "name": "GTT Platform",
    "slug": "gttplatform",
    "owner": "ostap87s-team",
    "scheme": "gttplatform",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ru.globaltechtour.platform"
    },
    "android": {
      "package": "ru.globaltechtour.platform",
      "adaptiveIcon": {
        "backgroundColor": "#1a73e8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "GTT Platform",
      "themeColor": "#1a73e8"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Микрофон нужен для голосовых заметок к визитам и для переводчика."
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Камера нужна, чтобы сфотографировать визитку или сделать фото к заметке о визите.",
          "photosPermission": "Доступ к фото нужен, чтобы добавить снимок визитки или фото к заметке о визите."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1a73e8"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Геопозиция нужна, только когда вы сами нажимаете «Отправить координатору, где я» в разделе «Помощь»."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Календарь нужен, чтобы добавить программу поездки — визиты, переезды и обеды — в ваш календарь."
        }
      ],
      "expo-document-picker",
      "expo-image"
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "139934bd-0f11-4e23-a7fe-a94508f7b980"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/139934bd-0f11-4e23-a7fe-a94508f7b980"
    }
  }
}
